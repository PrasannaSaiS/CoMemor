{
  "name": "comemor",
  "version": "1.0.1",
  "description": "CoMemor — repository-scoped AI agent memory MCP server. Records errors and fixes, redacts secrets, and surfaces relevant context to your AI coding tools. Targets MCP specification 2026-07-28.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "memory",
    "antigravity",
    "cursor",
    "claude",
    "error-fix",
    "agentic-development"
  ],
  "homepage": "https://github.com/PrasannaSaiS/CoMemor#readme",
  "bugs": {
    "url": "https://github.com/PrasannaSaiS/CoMemor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrasannaSaiS/CoMemor.git"
  },
  "license": "MIT",
  "author": "Prasanna Sai",
  "type": "module",
  "main": "dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "comemor": "dist/server.js",
    "comemor-dashboard": "dashboard/bridge/dist/bundle.cjs"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "files": [
    "dist",
    "dashboard/bridge/dist",
    "dashboard/frontend/dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "vitest run tests/e2e",
    "benchmark": "npm run build && node --experimental-vm-modules --input-type=module -e \"import('./dist-benchmark/scripts/benchmark/harness.js')\"",
    "benchmark:build": "tsc -p tsconfig.benchmark.json",
    "benchmark:run": "npx tsx scripts/benchmark/harness.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "build:dashboard:bridge": "node scripts/bundle-bridge.mjs",
    "build:dashboard:frontend": "npm --prefix dashboard/frontend run build",
    "build:all": "npm run build && npm run build:dashboard:bridge && npm run build:dashboard:frontend"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.0",
    "pino": "9.7.0",
    "uuid": "11.1.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "0.14.1",
    "@types/node": "22.15.21",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.35.0",
    "@typescript-eslint/parser": "8.35.0",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.29.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.4.1",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}